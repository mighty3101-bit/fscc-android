<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#121417">

    <TextView
        android:id="@+id/txtStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Statut : ARRÊTÉ"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#FF6B6B"
        android:paddingBottom="4dp" />

    <TextView
        android:id="@+id/txtStats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Autorisés : 0  |  Bloqués : 0  |  HTTP : 0  |  Switch : —"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:textColor="#9CA3AF"
        android:paddingBottom="10dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Interface réseau (ex: wlan2 pour le hotspot) :"
        android:textColor="#CCCCCC"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp">

        <Spinner
            android:id="@+id/spinnerIfaces"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="#1F242B" />

        <Button
            android:id="@+id/btnRefresh"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:text="Rafraîchir" />
    </LinearLayout>

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/switchAutoHotspot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:checked="true"
        android:text="Allumer / couper le hotspot automatiquement"
        android:textColor="#EAEAEA"
        android:layout_marginBottom="8dp" />

    <RadioGroup
        android:id="@+id/rgMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <RadioButton
            android:id="@+id/rbStrict"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:checked="true"
            android:text="FSCC Strict"
            android:textColor="#EAEAEA"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/rb90dns"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="90DNS"
            android:textColor="#EAEAEA"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/rbWhitelist"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Whitelist"
            android:textColor="#EAEAEA"
            android:textSize="13sp" />
    </RadioGroup>

    <LinearLayout
        android:id="@+id/layoutWhitelist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:layout_marginBottom="8dp">

        <EditText
            android:id="@+id/editWhitelist"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="youtube.com, github.com..."
            android:textColor="#EAEAEA"
            android:textColorHint="#6B7280"
            android:textSize="12sp"
            android:background="#1F242B"
            android:padding="8dp"
            android:maxLines="2"
            android:inputType="textNoSuggestions|textMultiLine" />

        <Button
            android:id="@+id/btnSaveWhitelist"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:text="OK" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <Button
            android:id="@+id/btnToggle"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Démarrer FSCC Strict" />

        <Button
            android:id="@+id/btnDomains"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:text="Domaines (0)" />

        <Button
            android:id="@+id/btnClear"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:text="Vider" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollLogs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#0B0D10"
        android:padding="10dp">

        <TextView
            android:id="@+id/txtLogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="#D0E0D0"
            android:textSize="12sp"
            android:text="Prêt. Choisis ton mode et appuie sur Démarrer." />
    </ScrollView>
</LinearLayout>
